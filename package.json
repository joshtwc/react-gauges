{
  "name": "@joshtwc/react-gauges",
  "version": "0.3.0",
  "description": "Detailed, themeable SVG gauges and meters for React: dials, thermometers, compasses, clinometers, tanks, rings and more. Zero dependencies, Tailwind-friendly.",
  "keywords": [
    "react",
    "gauge",
    "meter",
    "dial",
    "speedometer",
    "thermometer",
    "compass",
    "clinometer",
    "inclinometer",
    "attitude-indicator",
    "svg",
    "dashboard",
    "tailwind",
    "tailwindcss",
    "weather",
    "weather-icon"
  ],
  "author": "joshtwc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshtwc/react-gauges.git"
  },
  "homepage": "https://github.com/joshtwc/react-gauges#readme",
  "bugs": {
    "url": "https://github.com/joshtwc/react-gauges/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --exclude-entrypoints tailwind.css",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  }
}
